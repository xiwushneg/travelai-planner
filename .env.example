# 后端运行环境示例；不要提交真实密钥。
# production 下若 COOKIE_SECURE 未开启，服务会在启动时拒绝启动。
# 应用自身只监听 HTTP，生产必须由反向代理终止 TLS 后再对外提供服务；
# 仅在直接访问 HTTP 的本地调试场景改为 TRAVELAI_ENV=development。
TRAVELAI_ENV=production
TRAVELAI_COOKIE_SECURE=true
# 仅在可信反向代理（Nginx 等）后面才设为 true，否则可伪造 X-Forwarded-For 绕过限流。
TRAVELAI_TRUST_PROXY=false

# 审计用户名哈希的 HMAC 密钥；生产请替换为随机长串（改动后旧审计记录的账号检索会失配）。
TRAVELAI_AUDIT_KEY=please-change-this-audit-key

TRAVELAI_DB_PATH=./data/travelai.db
TRAVELAI_SEED_DEMO=true
TRAVELAI_EVIDENCE=true

# 路线适配器：local（默认）/ mock（离线测试）/ baidu
TRAVELAI_MAP_PROVIDER=local
BAIDU_MAP_AK=
BAIDU_ROUTE_MODE=walking
TRAVELAI_MAP_TIMEOUT_SECONDS=4
TRAVELAI_MAP_MAX_CALLS_PER_PLAN=40
